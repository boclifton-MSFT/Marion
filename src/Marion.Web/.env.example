# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# Private upstream API URL, used only by the Nuxt server proxy
NUXT_API_BASE=http://localhost:5435

# Google OpenID Connect configuration. Keep local values only in the ignored .env file.
NUXT_OAUTH_OIDC_ISSUER=https://accounts.google.com
NUXT_OAUTH_OIDC_CLIENT_ID=
NUXT_OAUTH_OIDC_CLIENT_SECRET=
NUXT_OAUTH_OIDC_REDIRECT_URI=https://localhost:7257/auth/google/callback

# At least 32 random characters. Keep the value only in the ignored .env file.
NUXT_SESSION_PASSWORD=

# Durable server-only authentication store. Aspire supplies its local mariondb connection.
# Set a private production connection through the deployment secret store; never expose it to the browser.
NUXT_AUTH_STORE_CONNECTION_STRING=

# Local development only. The Aspire AppHost sets this to true to provision the local schema.
# Keep false in production after the controlled schema-provisioning step has completed.
NUXT_AUTH_STORE_PROVISION_SCHEMA=false